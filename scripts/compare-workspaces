#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s REFERENCE_DIR WORKSPACE_DIR RESULT_FILE --authorized RELATIVE_FILE [--authorized RELATIVE_FILE...] [--exclude NAME...]\n' "$(basename "$0")" >&2
}

if (( $# < 3 )); then
    usage
    exit 64
fi

reference_dir=$1
workspace_dir=$2
result_file=$3
shift 3
[[ -d "$reference_dir" && -d "$workspace_dir" ]] || { printf 'Both directories are required.\n' >&2; exit 66; }
exclude_args=()
authorized_files=()
while (( $# > 0 )); do
    case $1 in
        --authorized)
            (( $# >= 2 )) || { printf '%s requires a file.\n' "$1" >&2; exit 64; }
            authorized_files+=("$2")
            shift 2
            ;;
        --exclude)
            (( $# >= 2 )) || { printf '%s requires a name.\n' "$1" >&2; exit 64; }
            exclude_args+=(--exclude="$2")
            shift 2
            ;;
        *)
            printf 'Unexpected argument: %s\n' "$1" >&2
            exit 64
            ;;
    esac
done
(( ${#authorized_files[@]} > 0 )) || { printf 'At least one --authorized file is required.\n' >&2; exit 64; }
for authorized_file in "${authorized_files[@]}"; do
    [[ "$authorized_file" != /* && "$authorized_file" != ./* && "$authorized_file" != */../* && "$authorized_file" != ../* && "$authorized_file" != */.. && "$authorized_file" != .. ]] || { printf 'Authorization path must be relative and contain no traversal: %s\n' "$authorized_file" >&2; exit 64; }
done
started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
set +e
if (( ${#exclude_args[@]} > 0 )); then
    diff_output=$(diff -rq "${exclude_args[@]}" "$reference_dir" "$workspace_dir" 2>&1)
else
    diff_output=$(diff -rq "$reference_dir" "$workspace_dir" 2>&1)
fi
diff_exit_code=$?
set -e
completed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
observed_differences=()
unauthorized_differences=()
if (( diff_exit_code > 1 )); then
    status=COMMAND_FAILED
else
    if (( diff_exit_code == 1 )); then
        while IFS= read -r difference; do
            [[ -n "$difference" ]] || continue
            if [[ "$difference" == "Only in $reference_dir:"* || "$difference" == "Only in $reference_dir/"* ]]; then
                only_path=${difference#Only in }
                only_directory=${only_path%: *}
                only_name=${only_path##*: }
                observed_differences+=("${only_directory#"$reference_dir"/}/$only_name")
            elif [[ "$difference" == "Files $reference_dir/"*" and $workspace_dir/"*" differ" ]]; then
                difference=${difference#Files "$reference_dir"/}
                difference=${difference% and "$workspace_dir"/* differ}
                observed_differences+=("$difference")
            elif [[ "$difference" == "Only in $workspace_dir:"* || "$difference" == "Only in $workspace_dir/"* ]]; then
                only_path=${difference#Only in }
                only_directory=${only_path%: *}
                only_name=${only_path##*: }
                observed_differences+=("${only_directory#"$workspace_dir"/}/$only_name")
            fi
        done <<< "$diff_output"
    fi
    for observed_difference in "${observed_differences[@]:-}"; do
        authorized=false
        for authorized_file in "${authorized_files[@]}"; do
            if [[ "$observed_difference" == "$authorized_file" || "$observed_difference" == "$authorized_file/"* ]]; then
                authorized=true
                break
            fi
        done
        $authorized || unauthorized_differences+=("$observed_difference")
    done
    if (( ${#observed_differences[@]} == 0 )); then status=IDENTICAL
    elif (( ${#unauthorized_differences[@]} == 0 )); then status=AUTHORIZED_DIFFERENCES_ONLY
    else status=UNAUTHORIZED_DIFFERENCES
    fi
fi
mkdir -p "$(dirname "$result_file")"
if (( ${#exclude_args[@]} > 0 )); then
    command_text="diff -rq ${exclude_args[*]} $reference_dir $workspace_dir"
else
    command_text="diff -rq $reference_dir $workspace_dir"
fi
authorized_json=$(printf '%s\n' "${authorized_files[@]}" | jq -Rsc 'split("\n")[:-1]')
observed_json=$(printf '%s\n' "${observed_differences[@]:-}" | jq -Rsc 'split("\n") | map(select(length > 0))')
unauthorized_json=$(printf '%s\n' "${unauthorized_differences[@]:-}" | jq -Rsc 'split("\n") | map(select(length > 0))')
exclusions_json=$(printf '%s\n' "${exclude_args[@]:-}" | jq -Rsc 'split("\n") | map(select(length > 0) | sub("^--exclude="; ""))')
if [[ "$status" == COMMAND_FAILED || "$status" == UNAUTHORIZED_DIFFERENCES ]]; then recorded_exit_code=1; else recorded_exit_code=0; fi
jq -n --arg command "$command_text" --arg startedAt "$started_at" --arg completedAt "$completed_at" --arg rawResult "$diff_output" --arg status "$status" --argjson diffExitCode "$diff_exit_code" --argjson exitCode "$recorded_exit_code" --argjson authorizedFiles "$authorized_json" --argjson observedDifferences "$observed_json" --argjson unauthorizedDifferences "$unauthorized_json" --argjson exclusions "$exclusions_json" '{command: $command, startedAt: $startedAt, completedAt: $completedAt, diffExitCode: $diffExitCode, exitCode: $exitCode, status: $status, authorizedFiles: $authorizedFiles, observedDifferences: $observedDifferences, unauthorizedDifferences: $unauthorizedDifferences, exclusions: $exclusions, rawResult: $rawResult}' > "$result_file"
if [[ "$status" == UNAUTHORIZED_DIFFERENCES || "$status" == COMMAND_FAILED ]]; then exit 1; fi
exit 0
